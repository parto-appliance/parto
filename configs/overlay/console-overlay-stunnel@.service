[Unit]
Description=Parto dedicated OVERLAY TLS wrapper (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/parto-overlay/%i/current/stunnel.conf

[Service]
Type=simple
ExecStart=/usr/bin/stunnel4 /var/lib/parto-overlay/%i/current/stunnel.conf
RuntimeDirectory=console-overlay-wrapper/%i
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/console-overlay-wrapper/%i
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET
